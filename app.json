{
    "$schema": "https://schema.native-sdk.dev/app/v1.json",
    "id":"dev.keco.studio",
    "name":"keco-studio",
    "display_name":"Keco Studio",
    "version": "0.1.0",
    "icons": ["assets/icon.png"],
    "platforms": ["macos", "windows"],
    "permissions": [],
    "capabilities": ["webview", "js_bridge", "open_url"],
    "bridge": {
        "commands": [{
            "name": "desktop.begin_google_oauth",
            "origins": ["https://keco-studio-main.vercel.app"]
        }]
    },
    "security": {
        "navigation": {
            "allowed_origins": ["https://keco-studio-main.vercel.app"],
            "external_links": {
                "action": "open_system_browser",
                "allowed_urls": ["https://lulrcirmwwvvnupmwqcq.supabase.co/auth/v1/authorize*"]
            }
        }
    },
    "web_engine": "system",
    "cef": { "dir": "third_party/cef/macos", "auto_install": false },
    "dmg": {
        "items": [
            { "kind": "app", "position": { "x": 166, "y": 182 } },
            { "kind": "applications", "position": { "x": 486, "y": 182 } },
            {
                "kind": "file",
                "path": "installer/macos/Create Desktop Shortcut.command",
                "name": "Create Desktop Shortcut.command",
                "position": { "x": 330, "y": 182 }
            }
        ]
    },
    "windows": [
        { "label": "main", "title":"Keco Studio", "width": 1280, "height": 800, "restore_state": true }
    ]
}
